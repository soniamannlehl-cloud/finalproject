# --- LLM Configuration ---
# Which provider get_llm() uses by default: "openai" or "google"
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- Financial Data ---
# Fallback only (yfinance is primary, no key required)
ALPHA_VANTAGE_API_KEY=

# --- News ---
# Primary news source for Sentiment Analyst + Macro/Industry Analyst
NEWSAPI_KEY=
# Fallback news source reuses ALPHA_VANTAGE_API_KEY above (NEWS_SENTIMENT endpoint)

# --- Macro Data ---
FRED_API_KEY=

# --- LangSmith (optional tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investment-research-platform

# --- Checkpointer ---
CHECKPOINT_DB=checkpoints.db
