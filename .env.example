# ============================================================================
# AI Investment Research Platform -- environment configuration
# ============================================================================
# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The platform is designed to run with ZERO paid keys except an LLM key:
# yfinance needs no key and anchors every data-provider fallback chain.
# Missing optional keys degrade a run and are disclosed in the report --
# they never crash the workflow.
# ============================================================================

# --- REQUIRED: LLM ----------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- STRONGLY RECOMMENDED: observability ------------------------------------
# Free tier. This is what makes agent reasoning inspectable end to end.
# https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investment-research-platform
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- OPTIONAL: data providers (each has a keyless fallback) ------------------
# Financial Modeling Prep -- statements, ratios   https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# NewsAPI -- company + industry news              https://newsapi.org/register
NEWSAPI_KEY=
# Tavily -- web search fallback                   https://tavily.com
TAVILY_API_KEY=
# Polygon -- market data (Polygon.io rebranded to Massive.com, Oct 2025)
# Same API key works on api.massive.com and api.polygon.io
POLYGON_API_KEY=

# SEC EDGAR needs no key, but REJECTS (403) any User-Agent without contact info.
# Format: a name plus a reachable address. Replace with your own email.
SEC_USER_AGENT=AI Investment Research Platform your.email@example.com

# --- DATABASE ---------------------------------------------------------------
POSTGRES_USER=irp
POSTGRES_PASSWORD=irp
POSTGRES_DB=irp

# --- RUNTIME ----------------------------------------------------------------
LOG_LEVEL=INFO
