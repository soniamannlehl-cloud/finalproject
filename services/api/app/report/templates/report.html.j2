<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>{{ report.company_name }} ({{ report.ticker }}) — Investment Research Report</title>
  <style>
    body { font-family: 'Segoe UI', system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; color: #1e293b; line-height: 1.65; font-size: 15px; }
    h1 { font-size: 1.75rem; font-weight: 700; border-bottom: 3px solid #2563eb; padding-bottom: 0.5rem; margin-bottom: 0.25rem; }
    h2 { font-size: 1.15rem; color: #1d4ed8; margin-top: 2rem; margin-bottom: 0.75rem; font-weight: 600; }
    h3 { font-size: 0.95rem; color: #475569; margin-top: 1.25rem; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.03em; }
    .meta { color: #64748b; font-size: 0.875rem; margin-bottom: 1.5rem; }
    .recommendation { background: linear-gradient(135deg, #eff6ff, #f8fafc); border: 1px solid #bfdbfe; border-left: 4px solid #2563eb; padding: 1rem 1.25rem; margin: 1.5rem 0; border-radius: 8px; }
    .recommendation strong { font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .section { margin-bottom: 2rem; }
    .section-body p { margin: 0.5rem 0; }
    .section-body ul { margin: 0.5rem 0; padding-left: 1.25rem; }
    .section-body li { margin: 0.25rem 0; }
    .thesis-framework h3 { font-size: 0.85rem; color: #64748b; margin-top: 1.25rem; margin-bottom: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .thesis-framework p { margin: 0.35rem 0; }
    table.data-table { width: 100%; border-collapse: collapse; margin: 0.75rem 0 1rem; font-size: 0.875rem; }
    table.data-table th { background: #f1f5f9; text-align: left; padding: 0.5rem 0.75rem; border: 1px solid #e2e8f0; font-weight: 600; }
    table.data-table td { padding: 0.5rem 0.75rem; border: 1px solid #e2e8f0; vertical-align: top; }
    table.data-table tr:nth-child(even) td { background: #f8fafc; }
    .disclaimer { font-size: 0.8rem; color: #94a3b8; margin-top: 3rem; border-top: 1px solid #e2e8f0; padding-top: 1rem; }
    .gaps { background: #fffbeb; border: 1px solid #fde68a; padding: 1rem; border-radius: 8px; margin-top: 1.5rem; }
    a { color: #2563eb; }
  </style>
</head>
<body>
  <h1>{{ report.company_name }} ({{ report.ticker }})</h1>
  <div class="meta">
    Investment Research Report · Generated {{ report.generated_at.strftime('%B %d, %Y') }}
    {% if report.approved_by_human %} · Approved by human reviewer{% endif %}
  </div>

  <div class="recommendation">
    <strong>{{ report.recommendation.action.value | replace('_', ' ') }}</strong>
    &nbsp;·&nbsp; Confidence: {{ (report.recommendation.confidence * 100) | round }}%
    &nbsp;·&nbsp; Evidence score: {{ report.recommendation.evidence_score }}
    {% if report.recommendation.was_downgraded %}
    <br/><em style="color:#92400e;">Downgraded: {{ report.recommendation.gate_reasons | join('; ') }}</em>
    {% endif %}
  </div>

  {% for section in sections %}
  <div class="section">
    <h2>{{ section.title }}</h2>
    <div class="section-body">{{ section.body | safe }}</div>
  </div>
  {% endfor %}

  {% if report.declared_gaps %}
  <div class="gaps">
    <h2>Research gaps</h2>
    <ul>{% for gap in report.declared_gaps %}<li>{{ gap }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <div class="disclaimer">
    Academic research simulation. Not investment advice. Every factual claim traces to cited evidence in the Sources section.
  </div>
</body>
</html>
